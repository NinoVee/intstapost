# ---------------------------------------------------------------------------
# Content Studio — copy to .env and fill in. NEVER commit .env.
# Generate secrets with:
#   openssl rand -base64 48   # APP_SECRET
#   openssl rand -base64 32   # ENCRYPTION_KEY (must decode to exactly 32 bytes)
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York

DATABASE_URL=postgres://intstapost:intstapost@localhost:5432/intstapost
REDIS_URL=redis://localhost:6379

APP_SECRET=
ENCRYPTION_KEY=

# Storage: local (private disk) or s3 (any S3-compatible private bucket, e.g. MinIO)
STORAGE_DRIVER=local
MEDIA_ROOT=./data/media
TEMP_ROOT=./data/tmp
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=intstapost-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Comma-separated folders the agent may read (e.g. an iCloud Photos export folder).
MEDIA_IMPORT_ROOTS=
MAX_UPLOAD_MB=500
SIGNED_URL_TTL_SECONDS=300
TEMP_FILE_MAX_AGE_HOURS=24

# Safety. Publishing stays OFF unless you explicitly turn it on, and even then
# every post needs your approval of the exact content.
PUBLISHING_ENABLED=false
ALLOW_EXTERNAL_TRAINING=false

# Cost control for external AI APIs (cents)
AI_DAILY_BUDGET_CENTS=500
AI_MONTHLY_BUDGET_CENTS=5000

# --- Optional integrations (later phases; see docs/INTEGRATIONS.md) ---
ANTHROPIC_API_KEY=
# Higgsfield: "KEY_ID:KEY_SECRET" from https://cloud.higgsfield.ai — server-side only.
HIGGSFIELD_CREDENTIALS=
# The model endpoint path to use for identity-preserving image edits (from Higgsfield's docs/console).
HIGGSFIELD_IMAGE_EDIT_ENDPOINT=
HIGGSFIELD_VIDEO_ENDPOINT=
META_APP_ID=
META_APP_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
